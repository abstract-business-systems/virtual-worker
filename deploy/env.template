# Copy to /etc/virtual-worker/env (mode 640 root:abs-worker) or into
# docker/worker.env / your compose environment. NEVER commit real values.
# Wake name participants call (requirement 2)
VW_NAME=Alex
# Display name attributed to in-meeting speakers
VW_OPERATOR_NAME=Operator
# Team meetings are filed under (req 7/8 ACL context)
VW_TEAM=Product
# Timezone for reminders created in-meeting (req 4)
VW_TZ=UTC
# STT model (faster-whisper size)
VW_STT_MODEL=base.en
# Brain: 'pi' (Pi CLI) or 'openrouter'
VW_BRAIN_BACKEND=openrouter
VW_BRAIN_MODEL=openai/gpt-4o-mini
# Google account for Meet joins (req 1) - optional; guest join if unset
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# OpenRouter key (used when VW_BRAIN_BACKEND=openrouter)
OPENROUTER_API_KEY=
# --- brain 2.0: agentic control (computer use via vision model) -------------
#VW_CONTROL_MODEL=openai/gpt-6-luna

# --- ElevenLabs neural TTS (falls back to OpenRouter TTS if key is empty) ---
#VW_ELEVENLABS_API_KEY=
#VW_ELEVEN_VOICE=Adam
#VW_ELEVEN_MODEL=eleven_flash_v2_5
