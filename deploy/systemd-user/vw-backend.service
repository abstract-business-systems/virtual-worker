# ---- vw-backend.service: KB + ACL + brain + reminder scheduler ----
[Unit]
Description=Virtual worker backend
Wants=vw-display.service vw-audio.service
After=network-online.target
[Service]
Environment=VW_SOCKET=%h/run/agent.sock
Environment=VW_DB=%h/data/kb.db
Environment=PYTHONPATH=%h/virtual-worker/common:%h/virtual-worker/backend:%h/virtual-worker/agent
EnvironmentFile=-%h/worker.env
WorkingDirectory=%h/virtual-worker
ExecStart=%h/venv/bin/python3 -m vw_backend.server
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
