# ---- vw-agent.service: browser + audio/STT + screen loops ----
[Unit]
Description=Virtual worker agent
Requires=vw-backend.service vw-display.service vw-audio.service
[Service]
Environment=DISPLAY=:99
Environment=VW_SOCKET=%h/vw-data/run/agent.sock
Environment=VW_DB=%h/vw-data/db/kb.db
Environment=PYTHONPATH=%h/virtual-worker/common:%h/virtual-worker/backend:%h/virtual-worker/agent
EnvironmentFile=-%h/vw-data/config/worker.env
WorkingDirectory=%h/virtual-worker
ExecStart=%h/venv/bin/python3 -m vw_agent.agent
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target