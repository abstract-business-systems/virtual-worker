# Dedicated key slot for the Pipecat POC (git-ignored, never committed)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENROUTER_API_KEY=

# Optional shared reasoning and managed-job settings
# CHAT_THINK_MODEL=openai/gpt-4o-mini
# CHAT_TURN_TIMEOUT=90
# CHAT_JOB_TIMEOUT=600

# Optional read-only Friday context bridge, trusted operator CLI only.
# Set BOTH to enable. This does not authenticate meeting speakers.
# CHAT_WORKER_SOCKET=/path/to/agent.sock
# CHAT_WORKER_REQUESTER=authorized-operator-name
